{
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "panelId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "resources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "enabled": {
            "type": "boolean"
          },
          "deleted": {
            "type": "boolean"
          },
          "listen": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9a-fA-F:.]+$"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "endpoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9:.\\-]+$"
          },
          "externalPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "transport": {
            "type": "string",
            "enum": [
              "raw",
              "xhttp"
            ]
          },
          "security": {
            "type": "string",
            "enum": [
              "reality",
              "tls"
            ]
          },
          "sni": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9.\\-]+$"
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9:.\\-\\[\\]]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^/[A-Za-z0-9/_.\\-]*$"
          },
          "host": {
            "type": "string",
            "minLength": 0,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9.\\-]*$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "packet-up",
              "stream-up",
              "stream-one"
            ]
          },
          "certificate": {
            "type": "string",
            "minLength": 0,
            "maxLength": 512,
            "pattern": "^(/[^\\x00-\\x1f]*)?$"
          },
          "certificateKey": {
            "type": "string",
            "minLength": 0,
            "maxLength": 512,
            "pattern": "^(/[^\\x00-\\x1f]*)?$"
          },
          "region": {
            "type": "string",
            "enum": [
              "",
              "RU"
            ]
          }
        }
      }
    },
    "users": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
