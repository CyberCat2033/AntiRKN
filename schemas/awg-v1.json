{
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "protocol": {
      "type": "string",
      "enum": [
        "awg"
      ]
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$",
      "maxLength": 32
    },
    "panelId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$",
      "maxLength": 32
    },
    "resources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "maxLength": 80,
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "deleted": {
            "type": "boolean"
          },
          "endpoint": {
            "type": "string",
            "pattern": "^[A-Za-z0-9:.\\-]+$",
            "maxLength": 253
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "externalPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "pool": {
            "type": "string",
            "pattern": "^[0-9./]+$",
            "maxLength": 18
          },
          "pool6": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:/]*$",
            "maxLength": 50
          },
          "mtu": {
            "type": "integer",
            "minimum": 1280,
            "maximum": 1376
          },
          "keepalive": {
            "type": "integer",
            "minimum": 0,
            "maximum": 120
          },
          "options": {
            "type": "object",
            "properties": {
              "jc": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32,
                "default": 4,
                "config": "Jc"
              },
              "jmin": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1280,
                "default": 10,
                "config": "Jmin"
              },
              "jmax": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1280,
                "default": 50,
                "config": "Jmax"
              },
              "s1": {
                "type": "integer",
                "minimum": 12,
                "maximum": 128,
                "default": 12,
                "config": "S1"
              },
              "s2": {
                "type": "integer",
                "minimum": 12,
                "maximum": 128,
                "default": 12,
                "config": "S2"
              },
              "s3": {
                "type": "integer",
                "minimum": 12,
                "maximum": 128,
                "default": 12,
                "config": "S3"
              },
              "s4": {
                "type": "integer",
                "minimum": 12,
                "maximum": 128,
                "default": 12,
                "config": "S4"
              },
              "rekey-after-time": {
                "type": "string",
                "pattern": "^[0-9]{1,5}(-[0-9]{1,5})?$",
                "maxLength": 11,
                "range": true,
                "default": "100-120",
                "config": "RekeyAfterTime"
              },
              "rekey-timeout": {
                "type": "string",
                "pattern": "^[0-9]{1,5}(-[0-9]{1,5})?$",
                "maxLength": 11,
                "range": true,
                "default": "3-7",
                "config": "RekeyTimeout"
              },
              "reject-after-time": {
                "type": "string",
                "pattern": "^[0-9]{1,5}(-[0-9]{1,5})?$",
                "maxLength": 11,
                "range": true,
                "default": "150-180",
                "config": "RejectAfterTime"
              },
              "keepalive-timeout": {
                "type": "string",
                "pattern": "^[0-9]{1,5}(-[0-9]{1,5})?$",
                "maxLength": 11,
                "range": true,
                "default": "5-15",
                "config": "KeepaliveTimeout"
              },
              "max-handshake-attempts": {
                "type": "string",
                "pattern": "^[0-9]{1,5}(-[0-9]{1,5})?$",
                "maxLength": 11,
                "range": true,
                "default": "15-20",
                "config": "MaxHandshakeAttempts"
              },
              "random-trailers": {
                "type": "boolean",
                "default": true,
                "config": "RandomTrailers"
              },
              "disable-cookies": {
                "type": "boolean",
                "default": true,
                "config": "DisableCookies"
              },
              "i1": {
                "type": "string",
                "enum": [
                  "",
                  "<r 2><b 0x858000010001000000000669636c6f756403636f6d0000010001c00c000100010000105a00044d583737>"
                ],
                "default": "<r 2><b 0x858000010001000000000669636c6f756403636f6d0000010001c00c000100010000105a00044d583737>",
                "config": "I1"
              }
            }
          }
        }
      }
    },
    "users": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "maxLength": 32
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "revokedUsers": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{32}$"
      }
    }
  },
  "optional": [
    "revokedUsers"
  ]
}
